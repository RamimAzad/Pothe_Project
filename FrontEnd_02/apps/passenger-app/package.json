  "type": "module",
  "private": true,
  "description": "Pothe Passenger Android & Web Application",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "cap:sync": "npx cap sync android",
    "build:apk": "vite build && npx cap sync android && cd android && export JAVA_HOME=/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home && export ANDROID_HOME=/Users/ramimazad/Library/Android/sdk && ./gradlew assembleDebug && mkdir -p ../../../apk-output/passenger && cp app/build/outputs/apk/debug/app-debug.apk ../../../apk-output/passenger/passenger-debug.apk"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
